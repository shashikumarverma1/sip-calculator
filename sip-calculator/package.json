{
  "name": "sip-calculator",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "prebuild": "npx expo prebuild --platform android --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "build:android:prod:release": "cd android && ./gradlew bundleRelease && cd ..",
    "build:android:prod:apk": "cd android && ./gradlew assembleRelease && cd ..",
    "clean": "rm -rf android ios node_modules yarn.lock package-lock.json ios/Pods ios/Podfile.lock android/build && yarn install && npx expo install --check npx expo install --fix",
    "disk": "rm -rf ~/Library/Developer/Xcode/DerivedData/* ~/Library/Developer/Xcode/Archives/* ~/Library/Developer/Xcode/iOS\\ DeviceSupport/* ~/Library/Caches/CocoaPods/* && xcrun simctl delete unavailable",
    "update": "eas update --branch production  ",
    "build:prod:android": "eas build --platform android --profile production",
    "build:submit:prod:android": "eas submit --platform android --profile production",
    "build:prod:ios": "eas build --platform ios --profile production",
    "eas:secret": "eas env:push production --path .env --force"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "5.2.1",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "^58.0.21",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "matter-js": "^0.20.0",
    "query-string": "^9.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^10.16.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "30.0.0",
    "@types/matter-js": "^0.20.2",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^18.0.7",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.13",
    "react-test-renderer": "^19.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "zod": "^4.6.7"
  },
  "private": true
}

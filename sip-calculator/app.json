{
  "expo": {
    "name": "JarUp",
    "slug": "sip-calculator",
    "version": "1.0.0",
    "scheme": "jarup",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1420"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shashi.SipCalculator"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1420"
      },
      "package": "com.shashi.SipCalculator"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9acc456b-0176-4b94-a570-d36fab9f31ba"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
